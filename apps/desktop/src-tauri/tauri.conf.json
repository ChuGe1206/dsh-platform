{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-platform",
  "version": "0.1.1",
  "identifier": "io.dsh.platform",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Platform",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../../harness/apps/cli": "runtime/harness/apps/cli",
      "../../../config": "config",
      "../../../HARNESS_UPSTREAM.md": "docs/HARNESS_UPSTREAM.md"
    }
  }
}
