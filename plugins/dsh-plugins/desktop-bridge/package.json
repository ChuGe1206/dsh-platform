{
  "name": "@dsh-platform/desktop-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh-platform desktop/mobile/harmony bridge: notification, status, file-drop, theme-sync forwarding to the native shell HTTP server.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@dsh-platform/shared-bridge": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "typescript": "^5.8.0"
  }
}
