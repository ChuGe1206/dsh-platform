{
  "name": "@dsh-platform/dsh-session-backup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Periodic session backup with incremental diff, rotation and optional gzip compression.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
