{
  "name": "dsh-platform",
  "version": "0.1.1",
  "private": true,
  "description": "Cross-platform desktop / mobile / HarmonyOS shell for DeepSeek Harness (DSH) — zero source intrusion, Cordis patch injection only.",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev:desktop": "turbo run dev --filter=@dsh-platform/desktop",
    "dev:web": "pnpm --filter @dsh-platform/shared-ui dev",
    "prepare:harness": "node scripts/prepare-harness.mjs",
    "prepare:external": "node scripts/prepare-external-plugins.mjs",
    "sync:version": "node scripts/sync-version.mjs",
    "build:all": "node scripts/build-all.mjs",
    "publish:harmony": "node scripts/publish-harmony.mjs",
    "smoke:sidecar": "node scripts/smoke-sidecar.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "js-yaml": "^4.1.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.10"
  }
}
